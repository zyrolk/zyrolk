# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_ALLOWED_ORIGINS: Comma-separated production storefront origins.
# Defaults to these exact production and Firebase Hosting origins when omitted.
API_ALLOWED_ORIGINS="https://zyro.lk,https://www.zyro.lk,https://zyrolk-e0164.web.app"

# ALLOWED_SUPPLIER_DOMAINS: Optional comma-separated supplier host allowlist.
# Supplier hosts stored in Firestore remain subject to the server-side SSRF checks.
ALLOWED_SUPPLIER_DOMAINS="supplier.example.com"

# A2Z supplier credentials: only needed when using the A2Z supplier sync.
# Production values belong in Secret Manager. They may be the legacy a2z-global
# scalar pair or matching a2z-profiles-v1 maps documented in the production
# runbook. Never expose either value to Hosting/Vite configuration.
A2Z_USERNAME="MY_A2Z_USERNAME_OR_PROFILE_MAP"
A2Z_PASSWORD="MY_A2Z_PASSWORD_OR_PROFILE_MAP"
# Optional legacy compatibility only. Use exact HTTPS supplier hosts.
A2Z_LEGACY_CREDENTIAL_HOSTS="a2zdropshipping.lk,www.a2zdropshipping.lk"
A2Z_LEGACY_CREDENTIAL_REFERENCES=""

# Supplier worker cadence. Per-supplier Hourly / 3 Hours / 6 Hours / Daily
# eligibility remains stored in each supplier source document.
SUPPLIER_SYNC_SCHEDULE="every 15 minutes"
SUPPLIER_SYNC_JOB_DISPATCH_SCHEDULE="every 1 minutes"
SUPPLIER_QUEUE_WORKER_SCHEDULE="every 5 minutes"
SUPPLIER_OPERATIONAL_ALERT_MONITOR_SCHEDULE="every 5 minutes"

# Cloudinary browser-upload configuration. Use an unsigned preset restricted in Cloudinary.
VITE_CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="MY_CLOUDINARY_UNSIGNED_UPLOAD_PRESET"

# PayHere is temporarily disabled for the COD-only launch. No PayHere secrets
# or environment values are required by the deployed Functions.
PUBLIC_SITE_URL="https://zyro.lk"

# Secure default is enabled. Set false only for a controlled emulator session.
REQUIRE_APP_CHECK="true"
VITE_FIREBASE_APP_CHECK_SITE_KEY="MY_RECAPTCHA_ENTERPRISE_SITE_KEY"
VITE_FIREBASE_MEASUREMENT_ID="MY_FIREBASE_MEASUREMENT_ID"
